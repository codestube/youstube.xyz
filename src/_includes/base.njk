<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="youstubes website">
    <title>{{ title or 'youstube' }}</title>
    <style>html { background-color: #0d1117; }</style>
    <link rel="preload" href="/website-bg.png" as="image" type="image/png" fetchpriority="high">
    {# <link rel="preload" href="/final-font.ttf" as="font" type="font/ttf" crossorigin> #}
    <link rel="preload" href="/font-cursiveless.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="stylesheet" href="/styles/styles.css?v={{ assetVersion }}">
    <link rel="stylesheet" href="/styles/jquery.terminal.min.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <header>
        <nav>
            <a href="/" class="logo">youstube</a>
            <ul class="nav-links">
                <li><a href="/">Profile</a></li>
                <li><a href="/terminal/">Terminal</a></li>
                <li><a href="/posts/">Posts</a></li>
            </ul>
        </nav>
    </header>

    <div class="page-wrapper">
        <main>
            {{ content | safe }}
        </main>
    </div>

    <footer>
        <p>&copy; 2026 youstube. All rights reserved. <span aria-hidden="true">&middot;</span> Created with <a href="https://www.11ty.dev/">11ty</a>.</p>
    </footer>

    <script src="/scripts/jquery.min.js"></script>
    <script src="/scripts/jquery.terminal.min.js"></script>
    <script src="/scripts/terminal.js"></script>
    <script src="/scripts/script.js"></script>
</body>
</html>
