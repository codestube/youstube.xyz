---
layout: base.njk
title: ma blogs
description: im a writer after all. will be posting blogs soon
permalink: /posts/index.html
---

<section class="archive" data-archive>
    <div class="archive-header">
        <h1 class="archive-title">Writeups <span>&amp;</span> Blog Posts</h1>
        <p class="content-intro">im a writer after all. will be posting blogs soon</p>
    </div>

    <div class="archive-filters" role="group" aria-label="Filter posts by type">
        <button class="archive-filter active" type="button" data-filter="ctf" aria-pressed="true" aria-controls="archive-list">
            CTF Writeups <span class="archive-filter-count" data-filter-count="ctf">0</span>
        </button>
        <button class="archive-filter" type="button" data-filter="blog" aria-pressed="false" aria-controls="archive-list">
            Blog Posts <span class="archive-filter-count" data-filter-count="blog">0</span>
        </button>
    </div>

    <p class="archive-status visually-hidden" data-filter-status aria-live="polite"></p>

    <ul class="writeups-list" id="archive-list">
        {% for post in collections.archivePosts %}
        <li class="writeup-item" data-post-type="{{ post.data.contentType }}">
            <div class="archive-kicker">
                <span class="archive-chip">{{ "CTF" if post.data.contentType == "ctf" else "Blog" }}</span>
                <time class="archive-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
                <span>{{ post.data.event or post.data.displayDate or post.data.year }}</span>
                {% if post.data.category %}<span aria-hidden="true">/</span><span>{{ post.data.category }}</span>{% endif %}
            </div>
            <a href="{{ post.url }}" class="writeup-title">{{ post.data.title }}</a>
            <p>{{ post.data.description }}</p>
        </li>
        {% endfor %}
    </ul>

    <div class="archive-empty" data-filter-empty hidden>
        <p>No blogs yet, will write soon! :p</p>
    </div>
</section>

<script src="/scripts/writeup-filter.js"></script>
